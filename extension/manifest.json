{
  "manifest_version": 3,
  "name": "FahVoiceForge",
  "version": "1.2.0",
  "description": "Pengendali otomatis Text-to-Speech Google AI Studio untuk FahVoiceForge (Native Chrome Side Panel).",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "exclude_matches": [
        "https://aistudio.google.com/apps*",
        "https://aistudio.google.com/apikey*",
        "https://aistudio.google.com/settings*",
        "https://aistudio.google.com/usage*",
        "https://aistudio.google.com/billing*",
        "https://aistudio.google.com/docs*"
      ],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "exclude_matches": [
        "https://aistudio.google.com/apps*",
        "https://aistudio.google.com/apikey*",
        "https://aistudio.google.com/settings*",
        "https://aistudio.google.com/usage*",
        "https://aistudio.google.com/billing*",
        "https://aistudio.google.com/docs*"
      ],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Buka FahVoiceForge Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://aistudio.google.com/*"]
    }
  ]
}
